   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "source": "dr = read(\"drug_raw_counts.csv\")\nprint(f\"{'drug_raw (원문)':50}{'ingredient':30}{'n':>8}\")\nfor r in dr[:30]:\n    print(f\"{r['drug_raw'][:50]:50}{r['ingredient']:30}{int(r['n']):>8,}\")\nprint(\"\\n성분 수:\", len({r['ingredient'] for r in dr}), \"· AWaRe 미매핑 성분:\", sorted({r['ingredient'] for r in abx if not r['aware']}))\nprint(\"경로(route) 분포 상위:\", Counter(r['route'] for r in abx).most_common(8))",
   "outputs": []
